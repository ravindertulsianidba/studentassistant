{
  "expo": {
    "name": "Student Assistant",
    "slug": "studentassistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studentassistant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.decisivlabs.studentassistant",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan your schedule and syllabus to capture deadlines",
        "NSPhotoLibraryUsageDescription": "Import screenshots of schedules and emails",
        "NSMicrophoneUsageDescription": "Record lectures to generate study notes",
        "NSCalendarsUsageDescription": "Add your classes and deadlines to your calendar",
        "NSCalendarsFullAccessUsageDescription": "Add your classes and deadlines to your calendar",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E3F32"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "package": "com.decisivlabs.studentassistant",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E3F32"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record lectures to generate study notes"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2E3F32"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Add your classes and deadlines to your calendar"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-background-task",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.130940560692-ld17qvuahirmicb5o74qktuvvaa2cgnr"
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e65acdac-aafc-4757-8399-cc406ae598a9"
      }
    }
  }
}
