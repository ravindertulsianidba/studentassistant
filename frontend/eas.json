{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://studentassistant-api.decisivlabs.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "130940560692-ld17qvuahirmicb5o74qktuvvaa2cgnr.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://studentassistant-api.decisivlabs.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "130940560692-ld17qvuahirmicb5o74qktuvvaa2cgnr.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://studentassistant-api.decisivlabs.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "130940560692-ld17qvuahirmicb5o74qktuvvaa2cgnr.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
