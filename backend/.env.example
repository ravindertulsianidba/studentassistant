# Student Assistant — backend environment template.
# Copy to backend/.env and fill real values. NEVER commit real secrets (backend/.env is gitignored).
# Only the placeholders below are safe to keep in version control.

# ---- Core ----
MONGO_URL="mongodb://localhost:27017"
DB_NAME="student_assistant"
APP_ENV=production
# MUST be false in production (guards dev-login / dev-outbox).
ALLOW_INSECURE_DEV=false
CORS_ORIGINS=https://your-frontend-domain
JWT_SECRET=[ADD_A_LONG_RANDOM_SECRET_>=32_CHARS]
JWT_ISSUER=student-assistant

# ---- AI provider ----
AI_PROVIDER=openai
OPENAI_API_KEY=[ADD_OPENAI_API_KEY]
OPENAI_MODEL_JSON=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_TRANSCRIBE=gpt-4o-transcribe
OPENAI_MODEL_EMBED=text-embedding-3-small

# ---- Auth (Google) ----
GOOGLE_CLIENT_ID=[ADD_GOOGLE_WEB_CLIENT_ID]

# ---- SMTP (transactional email) ----
SMTP_HOST=[ADD_SMTP_HOST]
SMTP_PORT=587
SMTP_USERNAME=[ADD_SMTP_USERNAME]
SMTP_PASSWORD=[ADD_SMTP_PASSWORD]
SMTP_FROM_EMAIL=[ADD_FROM_EMAIL]
SMTP_FROM_NAME=Student Assistant
SMTP_USE_TLS=true

# ================= Monetization / entitlements / cost control =================
# Administrative daily AI request cap (cost protection). 0 = unlimited. Change ONLY via the
# admin API (/api/admin/ai-cap) or this env default — never exposed to consumers.
DEFAULT_DAILY_AI_LIMIT=150

# Premium 30-day allowances (approved audio allowance is 240 minutes — never 300).
PREMIUM_AUDIO_MINUTES_PER_CYCLE=240
PREMIUM_MAX_RECORDING_MINUTES=120
PREMIUM_AI_IMPORTS_PER_CYCLE=25
PREMIUM_IMPORT_PAGES_PER_CYCLE=150
PREMIUM_MAX_PAGES_PER_IMPORT=20
PREMIUM_MEMORY_QUESTIONS_PER_CYCLE=100
PREMIUM_DAILY_BRIEFINGS_PER_CYCLE=31
PREMIUM_WEEKLY_REVIEWS_PER_CYCLE=5

# Free one-time Starter Pack (lifetime, non-renewing).
FREE_STARTER_AUDIO_MINUTES=30
FREE_STARTER_AI_IMPORTS=2
FREE_STARTER_IMPORT_PAGES=10
FREE_STARTER_MEMORY_QUESTIONS=5
FREE_STARTER_AI_BRIEFINGS=2

# Launch price reference (Play Console provides the localized prices actually shown).
PRICE_MONTHLY_CAD=11.99
PRICE_ANNUAL_CAD=109.99
CAD_USD_RATE=0.73

# ---- Google Play billing (backend is the entitlement authority) ----
# Enable billing. Verification fails closed (HTTP 503, never a local grant) until the
# service-account credential + RTDN auth below are provided.
BILLING_ENABLED=true
# Android application id (package name) — must match the store listing.
GOOGLE_PLAY_PACKAGE_NAME=com.decisivlabs.studentassistant
# Subscription product + base-plan ids (must match Play Console exactly).
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=student_assistant_premium
GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_ANNUAL_BASE_PLAN_ID=annual
# Google Play Developer API service-account key (path to JSON on the server; NEVER commit the file).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=[ADD_PATH_TO_SERVICE_ACCOUNT_JSON]
# RTDN Pub/Sub push authentication. Prefer OIDC: the service-account email that Pub/Sub signs as,
# and validate the audience via the push subscription config. A shared token is a fallback.
PUBSUB_SERVICE_ACCOUNT_EMAIL=[ADD_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL]
PUBSUB_VERIFICATION_TOKEN=[OPTIONAL_SHARED_RTDN_TOKEN]
# RTDN Pub/Sub topic/subscription for reference (configured in Google Cloud + Play Console):
#   Topic:        projects/<gcp-project>/topics/<rtdn-topic>
#   Subscription: projects/<gcp-project>/subscriptions/<rtdn-push-sub> -> POST /api/billing/google/rtdn

# Comma-separated administrator emails authorized for cost controls + monetization reports.
ADMIN_EMAILS=[ADD_ADMIN_EMAIL]

# Emergency per-feature kill switches (comma-separated feature keys).
KILL_SWITCHES=
# Raw-media / temp-file retention (hours) for storage cost control.
RAW_AUDIO_RETENTION_HOURS=24
TEMP_UPLOAD_RETENTION_HOURS=24
